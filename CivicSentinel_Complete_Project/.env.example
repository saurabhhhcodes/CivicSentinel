# CivicSentinel Environment Configuration Template
PROCESSING_MODE=LOCAL
DATABASE_URL=sqlite:///./data/civicsentinel.db
CIVICSENTINEL_DATA_DIR=./data
MAX_UPLOAD_MB=250
VIDEO_SAMPLE_EVERY=15
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Notification Service Configuration (MOCK, SMTP, or SES)
NOTIFICATION_PROVIDER=MOCK

# SMTP Configuration (Used when NOTIFICATION_PROVIDER=SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=civicsentinel@city.local
SMTP_TLS=true

# AWS Integration Configuration (Used when NOTIFICATION_PROVIDER=SES or AWS mode active)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
SES_SENDER_EMAIL=civicsentinel@example.com
